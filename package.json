{
  "name": "666-music",
  "description": "666 MUSIC \u2014 a free, open-source Discord music bot built with discord.js and discord-player",
  "version": "1.2.2",
  "main": "src/index.js",
  "scripts": {
    "start": "node .",
    "dev": "nodemon run node --trace-warnings .",
    "test": "node . mode=test",
    "commit": "cz",
    "docker:build": "docker build --tag 666-music .",
    "docker:shell": "docker run -it --rm 666-music sh",
    "docker:start": "docker run -it -p 3000:3000 --env-file ./.env -d --name 666-music 666-music",
    "docker:restart": "docker restart 666-music",
    "docker:stop": "docker stop 666-music",
    "docker:kill": "docker rm -f 666-music",
    "docker:purge": "docker rm -fv 666-music",
    "docker:logs": "docker logs 666-music -f",
    "docker:image": "docker image tag 666-music ${DOCKER_USERNAME:?Set DOCKER_USERNAME}/666-music",
    "docker:push": "docker push ${DOCKER_USERNAME:?Set DOCKER_USERNAME}/666-music",
    "docker:update": "git pull && npm install && npm run docker:stop && npm run docker:kill && npm run docker:build && npm run docker:start",
    "docker:dev:build": "docker build --tag 666-music-dev -f ./.devcontainer/.Dockerfile .",
    "docker:dev:start": "docker run -it --rm -v $(pwd):/app -v /app/node_modules -p 3000:3000 -p 9229:9229 -w /app 666-music-dev",
    "pm2:start": "pm2 start --name=666-music npm -- run start",
    "pm2:stop": "pm2 stop 666-music",
    "pm2:purge": "pm2 stop 666-music && pm2 delete 666-music && pm2 reset 666-music",
    "pm2:logs": "pm2 logs --lines 300 666-music",
    "pm2:logsError": "pm2 logs --err --lines 300 666-music"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/rest": "^2.6.3",
    "@mirasaki/logger": "file:./vendor/@mirasaki/logger",
    "@snazzah/davey": "^0.1.11",
    "chalk": "^4.1.2",
    "common-tags": "^1.8.2",
    "discord-player": "^7.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.3.1",
    "lokijs": "^1.5.12",
    "mediaplex": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HOOOOOOQ/666MSC.git"
  },
  "keywords": [
    "nodejs",
    "bot-template",
    "template",
    "boilerplate",
    "discord-api",
    "typings",
    "discord",
    "discordjs",
    "v14",
    "discord-bot",
    "music-bot",
    "music",
    "slash-commands",
    "buttons",
    "modals",
    "autocomplete",
    "context-menus",
    "select-menus",
    "documented"
  ],
  "author": "Richard Hillebrand (Mirasaki)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HOOOOOOQ/666MSC/issues"
  },
  "homepage": "https://github.com/HOOOOOOQ/666MSC#readme",
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=20.0.0 <22.0.0"
  },
  "displayName": "666 MUSIC"
}
